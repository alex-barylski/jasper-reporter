				<textFieldExpression><![CDATA[$F{Comments} == null || $F{Comments}.size() == 0 ? "" : ({
					def src = (java.util.List) $F{Comments}
					def sb = new StringBuilder()
					for (int i=0;i<src.size();i++) {
						def e = src.get(i)
						def t = ""
						if (e == null) t = ""
						else if (e instanceof java.util.Map) t = (e.get("text") == null ? "" : e.get("text").toString())
						else t = e.toString()
						sb.append(t)
						if (i < src.size()-1) sb.append(System.getProperty("line.separator"))
					}
					return sb.toString()
				})()]]></textFieldExpression>
			</textField>
